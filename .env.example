# LitSense environment. Copy to .env (never commit .env). Every value here is a safe placeholder.
# The API reads ./.env or ../../.env; docker compose reads ./.env.

# ---------------------------------------------------------------- API server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of proxies in front of the API (1 on Render or behind nginx); 0 locally.
TRUST_PROXY=0

# ---------------------------------------------------------------- data
MONGODB_URI=mongodb://127.0.0.1:27017/litsense
# Optional. When set: Redis cache, Redis rate-limit store, BullMQ jobs. When empty: in-memory equivalents.
REDIS_URL=

# ---------------------------------------------------------------- auth
# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Secure cookies default to true in production. SameSite=lax works when web and API share a site
# (the Vercel rewrite makes them same-origin). Use none (with Secure) only for a cross-site setup.
COOKIE_SAMESITE=lax
COOKIE_SECURE=
COOKIE_DOMAIN=
# Accounts registered with these emails get the admin role.
ADMIN_EMAILS=

# ---------------------------------------------------------------- model service (litsense_core over HTTP)
# mock = in-process TypeScript mock with the contract shapes; http = the Python model service.
MODEL_SERVICE_MODE=mock
MODEL_SERVICE_URL=http://localhost:8000
MODEL_SERVICE_KEY=
MODEL_SERVICE_TIMEOUT_MS=4000
MODEL_SERVICE_SLOW_TIMEOUT_MS=15000
MODEL_SERVICE_RETRIES=2
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MS=30000

# ---------------------------------------------------------------- behaviour
CACHE_TTL_S=600
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Run the BullMQ consumer inside the API process (single-instance deploys). Ignored without Redis.
WORKER_IN_PROCESS=true
# Seed the catalogue on boot when the books collection is empty.
SEED_ON_BOOT=true
